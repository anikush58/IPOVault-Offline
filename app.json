{
  "expo": {
    "name": "IPOVault",
    "slug": "ipovault",
    "version": "2.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ipovault",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-light.png",
      "resizeMode": "cover",
      "backgroundColor": "#FAFAFC",
      "dark": {
        "image": "./assets/images/splash-dark.png",
        "backgroundColor": "#090A0C",
        "resizeMode": "cover"
      }
    },
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "automatic",
      "splash": {
        "image": "./assets/images/splash-light.png",
        "resizeMode": "cover",
        "backgroundColor": "#FAFAFC",
        "dark": {
          "image": "./assets/images/splash-dark.png",
          "backgroundColor": "#090A0C",
          "resizeMode": "cover"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAFC",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "splash": {
        "image": "./assets/images/splash-light.png",
        "resizeMode": "cover",
        "backgroundColor": "#FAFAFC",
        "dark": {
          "image": "./assets/images/splash-dark.png",
          "backgroundColor": "#090A0C",
          "resizeMode": "cover"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ipovault.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-light.png",
          "resizeMode": "cover",
          "backgroundColor": "#FAFAFC",
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#090A0C",
            "resizeMode": "cover"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cee9106f-87cd-4458-86d2-46d6341a959d"
      }
    },
    "owner": "gradle58s-team"
  }
}