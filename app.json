{
  "expo": {
    "name": "IPOVault",
    "slug": "ipovault",
    "version": "2.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ipovault",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFC"
    },
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "light",
      "splash": {
        "image": "./assets/images/splash-light.png",
        "resizeMode": "contain",
        "backgroundColor": "#FAFAFC"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAFC",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "splash": {
        "image": "./assets/images/splash-light.png",
        "resizeMode": "contain",
        "backgroundColor": "#FAFAFC"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ipovault.app",
      "versionCode": 2,
      "allowBackup": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-light.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFC",
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#090A0C",
            "resizeMode": "contain"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "@react-native-google-signin/google-signin",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3768316467682663~8023640805",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "optimizeInitialization": true,
          "optimizeAdLoading": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#3B82F6",
          "defaultChannel": "ipovault-alerts"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cee9106f-87cd-4458-86d2-46d6341a959d"
      }
    },
    "owner": "gradle58s-team"
  }
}
